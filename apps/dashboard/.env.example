# Tulink dashboard environment configuration
# Copy this file to .env and fill in your values

# Local development uses the Clerk DEVELOPMENT instance (pk_test_/sk_test_).
# The deployed dashboard uses the PRODUCTION instance: its publishable key is
# baked into the image at build time from the NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# GitHub secret, and its secret key comes from the droplet's .env. Keep both
# halves on the same instance -- the API validates this at boot and will refuse
# to start on a mismatch.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
TULINK_API_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token
