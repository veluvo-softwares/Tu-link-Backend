# Tu-Link Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
NODE_ENV=development
PORT=3000

# Firebase Configuration (Required for auth)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
FIREBASE_API_KEY=your_firebase_api_key

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# NOTE: NEXT_PUBLIC_* variables do NOT belong in this file. This .env feeds the
# API; the dashboard reads apps/dashboard/.env locally, and on the droplet its
# NEXT_PUBLIC_* values are inlined into the bundle at image build time from
# GitHub secrets (see the build-args in .github/workflows/ci.yml). Setting one
# here has no effect -- and during a key rotation it looks like it should,
# which is worse than it being absent.

# Database
REDIS_HOST=localhost
REDIS_PORT=6379
# REQUIRED: Redis now enforces authentication (--requirepass). Set a strong,
# random value (e.g. `openssl rand -base64 32`). The same value is used by both
# the Redis server and the app, so they must match.
REDIS_PASSWORD=

# Security
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters

# Clerk (dashboard first, mobile later)
# Local development uses a Clerk DEVELOPMENT instance (pk_test_*). The deployed
# stack at https://dashboard.tulink.xyz runs against a Clerk PRODUCTION instance
# (pk_live_*). Rotating instances means updating THREE places, all of which must
# agree or auth breaks:
#   1. this file on the droplet          -> CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY
#   2. apps/dashboard/.env               -> local dashboard only
#   3. GitHub secret NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY -> baked into the
#      deployed dashboard image at build time; requires a rebuild to take effect
#
# apps/api/src/shared/clerk/clerk.env.ts validates all of this at boot and
# refuses to start on a bad combination, so a half-applied key rotation fails
# loudly instead of 401-ing every request. Rules it enforces:
#   - CLERK_SECRET_KEY and CLERK_PUBLISHABLE_KEY must be the same kind
#     (both sk_test_/pk_test_, or both sk_live_/pk_live_)
#   - NODE_ENV=production requires live keys and a non-empty
#     CLERK_AUTHORIZED_PARTIES
# The API's own copy of the publishable key. Same VALUE as the dashboard's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, but a separate variable on purpose: this
# one is read at runtime by NestJS, that one is compiled into the dashboard
# bundle at build time. Required -- the API will not start without it.
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# OPTIONAL. Read implicitly by verifyWebhook(); does not transfer between Clerk
# instances. Not needed for authentication -- ClerkAuthGuard re-syncs the
# caller's organizations from the Clerk API on every authenticated request.
# Set it only if you point Clerk webhooks at /webhooks/clerk, which additionally
# buys organization.deleted cleanup and prompt propagation of org renames.
# Leave unset and the API logs a notice at boot instead of failing.
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated list of allowed frontend origins for Clerk session tokens.
# Leaving this empty makes Clerk skip the authorized-party check entirely and
# accept a token minted for ANY origin on the instance, so it is mandatory in
# production. Deployed value: https://dashboard.tulink.xyz
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001

# CORS (for frontend)
# The dashboard reaches the API over the internal Docker network and its only
# browser fetch is same-origin, so it does not need an entry here. This list is
# for browser/Socket.IO clients that call the API cross-origin directly.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Keep Swagger disabled in production unless it is deliberately protected.
ENABLE_SWAGGER=false

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# RTDB cleanup delay after journey ends (ms)
RTDB_CLEANUP_DELAY_MS=5000

# Email Configuration (for email verification & notifications)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=TuLink <noreply@tulink.xyz>



# --- Postgres / PostGIS ---
POSTGRES_USER=tulink
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=tulink
POSTGRES_HOST=localhost     # app overrides to `postgres` inside Docker (set in compose)
POSTGRES_PORT=5432
POSTGRES_POOL_MAX=10
# Used by drizzle-kit, which runs from the HOST -> localhost
DATABASE_URL=postgresql://tulink:your-strong-postgres-password@localhost:5432/tulink

# Region code for places API
PLACES_REGION_CODE=KE
