{
  "name": "tulink-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "docker compose -p tulink-backend up --build",
    "stop": "docker compose -p tulink-backend down --remove-orphans",
    "dc": "docker compose -p tulink-backend",
    "build": "turbo run build",
    "build:api": "npm run build --workspace @tulink/api",
    "build:dashboard": "npm run build --workspace @tulink/dashboard",
    "dev": "npm run docker:dev && node scripts/wait-for-infra.mjs && turbo run dev",
    "format": "npm run format --workspace @tulink/api",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "db:generate": "npm run db:generate --workspace @tulink/api",
    "db:migrate": "npm run db:migrate --workspace @tulink/api",
    "db:push": "npm run db:push --workspace @tulink/api",
    "docker:dev": "docker compose -p tulink-backend up -d postgres redis",
    "docker:build": "docker compose -p tulink-backend build",
    "docker:down": "docker compose -p tulink-backend down --remove-orphans",
    "docker:logs": "docker compose -p tulink-backend logs -f",
    "prepare": "husky"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.3"
    }
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
